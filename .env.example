# Copie este arquivo para ".env" e preencha. O arquivo .env NÃO
# deve ir para o GitHub (já está no .gitignore).

# development = uso local (debug ligado). Em produção, NÃO defina
# esta variável (o padrão é production).
APP_ENV=development

# Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole-aqui-a-chave-gerada

# Só no servidor (PythonAnywhere): o site fica atrás de um proxy.
# Deixe comentado no seu computador.
# BEHIND_PROXY=1
